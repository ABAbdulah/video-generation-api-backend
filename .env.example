# Copy to .env.local and fill in. Never commit .env.local.

# Postgres (Neon) — pooled connection string
DATABASE_URL=

# JWT signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Comma-separated list of allowed browser origins (the frontend)
FRONTEND_ORIGIN=http://localhost:3000

# Port the API listens on (Railway injects PORT automatically)
PORT=4000

# Optional — upgrades embeddings to real semantic quality + Starter tier at M7
GEMINI_API_KEY=

# Required for Best/Pro tiers at M7
OPENROUTER_API_KEY=

# Blob storage (Milestone 11)
BLOB_READ_WRITE_TOKEN=
