{
  "name": "genvideo-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "embed:templates": "tsx --env-file=.env.local scripts/embed-templates.ts",
    "validate:templates": "tsx scripts/validate-templates.ts",
    "smoke:llm": "tsx --env-file=.env.local scripts/smoke-llm.ts",
    "smoke:render": "tsx --env-file=.env.local scripts/smoke-render.ts"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/standalone": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "@remotion/bundler": "4.0.496",
    "@remotion/renderer": "4.0.496",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.496",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/babel__standalone": "^7.1.9",
    "@types/babel__traverse": "^7.28.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.1.4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
